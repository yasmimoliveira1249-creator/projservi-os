function criarAgendamento(d){if(!d.Data||!d['Hora inicial']||!d['ID Cliente']||!d['ID Funcionário']||!d['ID Serviço'])throw Error('Data, hora, cliente, funcionário e serviço são obrigatórios.');const serv=indicePorId('Serviços','ID Serviço',d['ID Serviço']);if(!serv||serv.Status==='Inativo')throw Error('Serviço inválido.');if(!d['Hora final'])d['Hora final']=formatarHora(horarioMinutos(d['Hora inicial'])+Number(serv['Duração padrão (min)']));d['ID Agendamento']=gerarId('AGE');d.Status=d.Status||'Agendado';d.Valor=d.Valor!==undefined&&d.Valor!==''?d.Valor:serv['Preço padrão'];d['Data de criação']=new Date();validarAgendamento(d);return adicionarRegistro('Agenda',d);}
function listarAgendamentos(data){return lerTabela('Agenda').filter(a=>!data||normalizarData(a.Data).toDateString()===normalizarData(data).toDateString());}
function editarAgendamento(id,d){const a=indicePorId('Agenda','ID Agendamento',id);if(!a)throw Error('Agendamento não encontrado');const n=Object.assign({},a,d);validarAgendamento(n,id);return atualizarRegistro('Agenda','ID Agendamento',id,n);}
function cancelarAgendamento(id){const a=indicePorId('Agenda','ID Agendamento',id);if(!a)throw Error('Agendamento não encontrado');a.Status='Cancelado';atualizarRegistro('Agenda','ID Agendamento',id,a);}
function atualizarStatusAgendamento(id,status){if(!listarStatus().some(x=>x.Status===status))throw Error('Status inválido');const a=indicePorId('Agenda','ID Agendamento',id);if(!a)throw Error('Agendamento não encontrado');a.Status=status;atualizarRegistro('Agenda','ID Agendamento',id,a);}
