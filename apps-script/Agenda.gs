function criarAgendamento(d){if(!d.Data||!d['Hora inicial']||!d['ID Cliente']||!d['ID Funcionário']||!d['ID Serviço'])throw Error('Preencha data, hora, cliente, funcionário e serviço.');const s=indicePorId('Serviços','ID Serviço',d['ID Serviço']);if(!s||s.Status==='Inativo')throw Error('Serviço inválido.');if(!d['Hora final'])d['Hora final']=formatarHora(horarioMinutos(d['Hora inicial'])+Number(s['Duração padrão (min)']));d['ID Agendamento']=gerarId('AGE');d.Status='Agendado';d.Valor=d.Valor||s['Preço padrão'];d['Data de criação']=new Date();validarAgendamento(d);return adicionarRegistro('Agenda',d);} function listarAgendamentos(data){return lerTabela('Agenda').filter(a=>!data||normalizarData(a.Data).toDateString()===normalizarData(data).toDateString());} function editarAgendamento(id,d){const a=indicePorId('Agenda','ID Agendamento',id);if(!a)throw Error('Não encontrado');const n=Object.assign({},a,d);validarAgendamento(n,id);return atualizarRegistro('Agenda','ID Agendamento',id,n);} function atualizarStatusAgendamento(id,status){const a=indicePorId('Agenda','ID Agendamento',id);if(!a)throw Error('Não encontrado');a.Status=status;return atualizarRegistro('Agenda','ID Agendamento',id,a);}