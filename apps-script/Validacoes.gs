function validarAgendamento(d,ignorarId){const data=normalizarData(d.Data),ini=horarioMinutos(d['Hora inicial']),fim=horarioMinutos(d['Hora final']);if(isNaN(data.getTime())||fim<=ini)throw Error('Data ou intervalo de horário inválido.');if(existeBloqueio(d['ID Funcionário'],data,ini,fim))throw Error('Horário bloqueado.');const disp=disponibilidadeDia(d['ID Funcionário'],data.getDay());if(disp.length&&!disp.some(x=>ini>=horarioMinutos(x['Hora inicial'])&&fim<=horarioMinutos(x['Hora final'])&&(!x['Intervalo inicial']||!x['Intervalo final']||fim<=horarioMinutos(x['Intervalo inicial'])||ini>=horarioMinutos(x['Intervalo final']))))throw Error('Fora da disponibilidade.');for(const a of lerTabela('Agenda')){if(ignorarId&&a['ID Agendamento']===ignorarId)continue;if(String(a['ID Funcionário'])!==String(d['ID Funcionário'])||['Cancelado','Não compareceu'].includes(a.Status))continue;const ad=normalizarData(a.Data);if(ad.toDateString()!==data.toDateString())continue;const ai=horarioMinutos(a['Hora inicial']),af=horarioMinutos(a['Hora final']);if(ini<af&&fim>ai)throw Error('Conflito de horário para funcionário.');}return true;}
