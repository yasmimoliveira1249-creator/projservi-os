function validarAgendamento(d,ignorarId){const data=normalizarData(d.Data),i=horarioMinutos(d['Hora inicial']),f=horarioMinutos(d['Hora final']);if(isNaN(data.getTime())||f<=i)throw Error('Horário inválido');if(existeBloqueio(d['ID Funcionário'],data,i,f))throw Error('Bloqueio existente');const av=disponibilidadeDia(d['ID Funcionário'],data.getDay());if(av.length&&!av.some(x=>i>=horarioMinutos(x['Hora inicial'])&&f<=horarioMinutos(x['Hora final'])))throw Error('Fora da disponibilidade');for(const a of lerTabela('Agenda')){if(a['ID Agendamento']===ignorarId||String(a['ID Funcionário'])!==String(d['ID Funcionário'])||['Cancelado','Não compareceu'].includes(a.Status))continue;if(normalizarData(a.Data).toDateString()===data.toDateString()&&i<horarioMinutos(a['Hora final'])&&f>horarioMinutos(a['Hora inicial']))throw Error('Conflito de agenda');}return true;}